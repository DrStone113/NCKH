# ==========================================
# Frontend Config (Flutter Web)
# ==========================================
# The URL where the Flutter web app will make requests to the backend API
API_BASE_URL=https://chatbot.drstone.id.vn

# ==========================================
# Backend Config (FastAPI)
# ==========================================
# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://health:secret@postgres:5432/health_db
POSTGRES_USER=health
POSTGRES_PASSWORD=secret
POSTGRES_DB=health_db

# Vilao AI API Config
OPENAI_BASE_URL=https://api.vilao.ai/v1
LLM_MODEL=rk/llms/qwen-3.7-plus
HEAVY_LLM_MODEL=spd/deepseek-v4-pro
EMBEDDING_MODEL=BAAI/bge-m3

# AI API Keys
OPENAI_API_KEY=sk-a23e0512de87a9d3d205fb43307b53009de7cb77b94d28177789001a8efe5a73
DEEPSEEK_API_KEY=

# RAG config
MAX_HISTORY_TURNS=24
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.6

# External APIs
WGER_BASE_URL=https://wger.de/api/v2

# Cloudflare (Optional)
CLOUDFLARE_TUNNEL_TOKEN=
