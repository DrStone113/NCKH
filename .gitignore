# =============================================================
# SECRETS — KHÔNG BAO GIỜ COMMIT
# Sao chép từ .env.example và điền thông tin thực
# =============================================================

/.env
**/.env


# Firebase — chứa API keys, mỗi người tự cấu hình
**/google-services.json
**/GoogleService-Info.plist
/firebase/node_modules/
/firebase/.generated/
/.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# =============================================================
# FLUTTER SDK — cài riêng ngoài project, xem README
# =============================================================
/flutter/

# =============================================================
# FLUTTER APP (apps/mobile) — build & generated
# =============================================================
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.metadata
**/pubspec.lock
# Flutter applications should commit their resolved dependency graph.
!apps/mobile/pubspec.lock
**/devtools_options.yaml

# Android
**/android/local.properties
**/android/.gradle/
**/android/.kotlin/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/key.properties
*.jks
*.keystore
!**/debug.keystore


# Windows / desktop generated
**/windows/flutter/generated_plugin_registrant.cc
**/windows/flutter/generated_plugin_registrant.h
**/windows/flutter/generated_plugins.cmake
**/windows/flutter/ephemeral/

# =============================================================
# PYTHON BACKEND (apps/backend)
# venv tạo lại bằng: pip install -r requirements.txt
# =============================================================
**/venv/
**/.venv/
**/.venv-*/
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/.hypothesis/
**/.mypy_cache/
**/.ruff_cache/
*.egg-info/

# =============================================================
# DATA — output tạm sinh ra từ script
# =============================================================
data/generated/
# Local model artifacts are verified at runtime and must never enter Git.
.models/

# =============================================================
# EDITOR & OS
# =============================================================
.idea/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db
desktop.ini
# .vscode/ — giữ lại vì có settings hữu ích cho team

# Config riêng của từng AI IDE (không dùng chung cho team)
/rules/
/.continue/
**/.kiro/
/.playwright-cli/

# =============================================================
# LOGS & TMP
# =============================================================
*.log
apps/backend/logs/*.jsonl
*.tmp
*.bak
*.swp
