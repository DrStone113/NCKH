{
  "python.defaultInterpreterPath": "${workspaceFolder}/apps/backend/venv/Scripts/python.exe",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/apps/backend",
    "${workspaceFolder}/apps/backend/venv/Lib/site-packages"
  ],
  "python.autoComplete.extraPaths": [
    "${workspaceFolder}/apps/backend",
    "${workspaceFolder}/apps/backend/venv/Lib/site-packages"
  ],
  "python.testing.pytestArgs": ["apps/backend/tests"],
  "python.testing.pytestEnabled": true,
  "dart.flutterSdkPath": "C:\\flutter",
  "files.exclude": {
    "**/.agents": true,
    "**/.fvm": true,
    "**/.venv": true,
    "**/.venv-*": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.hypothesis": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.dart_tool": true,
    "**/.kiro": true,
    "**/.playwright": true,
    "**/.playwright-cli": true,
    "**/.flutter-plugins-dependencies": true,
    "**/build": true
  }
}
