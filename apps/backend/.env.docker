# ═══════════════════════════════════════════════════════════════════════════
# Docker Environment Configuration
# Copy this to .env and adjust values as needed
# ═══════════════════════════════════════════════════════════════════════════

# LLM Configuration
OPENAI_BASE_URL=http://ollama:11434
LLM_MODEL=llama3.2

# Database Configuration
DATABASE_URL=postgresql+asyncpg://health:secret@postgres:5432/health_db

# Embedding Model
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# RAG Configuration
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.5

# Chat Configuration
MAX_HISTORY_TURNS=10

# Wger API
WGER_BASE_URL=https://wger.de/api/v2

# Cloudflare Tunnel (for production deployment)
# Get token from: https://dash.cloudflare.com/
# CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here
