# ═══════════════════════════════════════════════════════════════════════════
# Docker Environment Configuration
# Copy this to .env and adjust values as needed
# ═══════════════════════════════════════════════════════════════════════════

# ─── LLM Provider (OpenAI-compatible) ──────────────────────────────────────
OPENAI_BASE_URL=https://api.vilao.ai/v1

# BẮT BUỘC — không có giá trị mặc định trong code.
OPENAI_API_KEY=

# Model nhẹ cho mọi lượt chat.
LLM_MODEL=op/MiniMax-M3

# Model nặng — chỉ dùng cho turn được router xếp tier "complex".
HEAVY_LLM_MODEL=clx/claude-opus-5

# ─── Embedding ─────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3

# ─── Database (service name "postgres" trong docker network) ───────────────
DATABASE_URL=postgresql+asyncpg://health:secret@postgres:5432/health_db
POSTGRES_USER=health
POSTGRES_PASSWORD=secret
POSTGRES_DB=health_db

# ─── Chat & RAG ────────────────────────────────────────────────────────────
MAX_HISTORY_TURNS=24
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.6

# ─── Wger API ──────────────────────────────────────────────────────────────
WGER_BASE_URL=https://wger.de/api/v2

# ─── Cloudflare Tunnel (production) ────────────────────────────────────────
# Get token from: https://dash.cloudflare.com/
# CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here
