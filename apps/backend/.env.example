# Sao chép file này thành .env và điền thông tin thực tế
# cp .env.example .env

# Ollama (chạy local/container)
OPENAI_BASE_URL=http://127.0.0.1:11434

# PostgreSQL — chạy local hoặc Docker
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/health_db

# LLM model (cần pull trước, ví dụ: ollama pull qwen2.5:14b)
LLM_MODEL=qwen2.5:14b

# Embedding model (tự download khi chạy lần đầu)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Cloudflare Tunnel (tuỳ chọn — để expose ra internet)
CLOUDFLARE_TUNNEL_TOKEN=

# Cấu hình RAG
MAX_HISTORY_TURNS=10
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.5

# wger API
WGER_BASE_URL=https://wger.de/api/v2
