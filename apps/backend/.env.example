# Sao chép file này thành .env và điền thông tin thực tế
# cp .env.example .env

# ═══════════════════════════════════════════════════════════════════════════
# LLM Provider (OpenAI-compatible)
# ═══════════════════════════════════════════════════════════════════════════
OPENAI_BASE_URL=https://api.vilao.ai/v1

# BẮT BUỘC — không có giá trị mặc định trong code. Lấy key từ nhà cung cấp.
OPENAI_API_KEY=

# Model nhẹ, dùng cho mọi lượt chat thông thường.
LLM_MODEL=mn/ag/gemini-3.6-flash-high

# Model nặng (reasoning) cho câu hỏi phức tạp. Loại này tiêu nhiều
# completion token cho phần reasoning trước khi sinh content, nên cần
# max_tokens rộng rãi (>= 800), nếu không content trả về sẽ rỗng.
HEAVY_LLM_MODEL=op/deepseek/deepseek-v4-pro

# Embedding model chạy local, tự download lần đầu.
EMBEDDING_MODEL=BAAI/bge-m3

# ═══════════════════════════════════════════════════════════════════════════
# PostgreSQL (pgvector) — chạy local hoặc qua docker compose
# ═══════════════════════════════════════════════════════════════════════════
DATABASE_URL=postgresql+asyncpg://health:secret@127.0.0.1:5432/health_db
POSTGRES_USER=health
POSTGRES_PASSWORD=secret
POSTGRES_DB=health_db

# ═══════════════════════════════════════════════════════════════════════════
# Bộ nhớ hội thoại & RAG
# ═══════════════════════════════════════════════════════════════════════════
# Một "turn" là một dòng trong chat_messages (gồm cả tool call/result),
# không phải một cặp user/assistant. Để quá thấp thì một câu hỏi nhiều tool
# ăn hết cửa sổ khiến bot mất mạch hội thoại.
MAX_HISTORY_TURNS=24
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.6

# ═══════════════════════════════════════════════════════════════════════════
# Dịch vụ ngoài
# ═══════════════════════════════════════════════════════════════════════════
WGER_BASE_URL=https://wger.de/api/v2

# Cloudflare Tunnel (tuỳ chọn — để expose ra internet)
CLOUDFLARE_TUNNEL_TOKEN=
