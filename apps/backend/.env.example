# Sao chép file này thành .env và điền thông tin thực tế
# cp .env.example .env

# ═══════════════════════════════════════════════════════════════════════════
# LLM Provider (OpenAI-compatible)
# ═══════════════════════════════════════════════════════════════════════════
OPENAI_BASE_URL=https://api.vilao.ai/v1

# BẮT BUỘC — không có giá trị mặc định trong code. Lấy key từ nhà cung cấp.
OPENAI_API_KEY=

# Model nhẹ, dùng cho mọi lượt chat thông thường.
LLM_MODEL=chr/charm/qwen3.8-flash

# Model nặng, chỉ dùng cho turn được router xếp tier "complex".
# Chậm hơn đáng kể và prompt_tokens cao, nên không đặt làm mặc định.
HEAVY_LLM_MODEL=op/deepseek/deepseek-v4-pro

# Optional reasoning control for compatible providers. For qwen3:8b through
# Ollama, set LLM_REASONING_EFFORT=none to preserve the visible output budget.
# LLM_REASONING_EFFORT=none

# Cost governor: prompt compact, hard call/output caps, no implicit paid-model
# fallback. Set mode=off only for a scoped rollback/comparison.
LLM_COST_OPTIMIZATION_MODE=optimized
LLM_CROSS_MODEL_FALLBACK=false
LLM_ATTEMPTS_PER_MODEL=1
LLM_CHITCHAT_MAX_OUTPUT_TOKENS=160
LLM_SIMPLE_MAX_OUTPUT_TOKENS=512
LLM_COMPLEX_MAX_OUTPUT_TOKENS=1200
LLM_SIMPLE_MAX_CALLS=2
LLM_COMPLEX_MAX_CALLS=3
LLM_SIMPLE_HISTORY_TURNS=6
LLM_COMPLEX_HISTORY_TURNS=12
LLM_MEMORY_SUMMARY_MAX_OUTPUT_TOKENS=512
LLM_MEMORY_FACT_MAX_OUTPUT_TOKENS=512

# Backend Optimization V2. Observe records decisions without rejecting load;
# enforce enables bounded queues/admission. No private response cache is used.
BACKEND_COST_MODE=observe
CHAT_QUEUE_SIZE=4
CHAT_ADMISSION_MIN_CONCURRENCY=2
CHAT_ADMISSION_INITIAL_CONCURRENCY=8
CHAT_ADMISSION_MAX_CONCURRENCY=16
CHAT_ADMISSION_TIMEOUT_SECONDS=1.0
CHAT_ADMISSION_RETRY_AFTER_MS=750
BACKGROUND_MEMORY_CONCURRENCY=1
PROACTIVE_LLM_PERSONALIZATION=false
PROACTIVE_LLM_MAX_OUTPUT_TOKENS=96
RAG_WARMUP_MODE=lazy
RAG_CPU_THREADS=2
RAG_INFERENCE_CONCURRENCY=1
RAG_LEXICAL_CONFIDENCE_THRESHOLD=0.18
RAG_LEXICAL_MARGIN_RATIO=1.5
PUBLIC_CACHE_MAX_ENTRIES=256
PUBLIC_CACHE_TTL_SECONDS=86400
PRIVATE_CACHE_TTL_SECONDS=120
HTTP_MAX_CONNECTIONS=32
HTTP_MAX_KEEPALIVE_CONNECTIONS=16
HTTP_KEEPALIVE_EXPIRY_SECONDS=30
HTTP_CIRCUIT_FAILURE_THRESHOLD=3
HTTP_CIRCUIT_RESET_SECONDS=30
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800

# Embedding model chạy local, tự download lần đầu.
EMBEDDING_MODEL=BAAI/bge-m3

# ═══════════════════════════════════════════════════════════════════════════
# PostgreSQL (pgvector) — chạy local hoặc qua docker compose
# ═══════════════════════════════════════════════════════════════════════════
DATABASE_URL=postgresql+asyncpg://health:secret@127.0.0.1:5432/health_db
POSTGRES_USER=health
POSTGRES_PASSWORD=secret
POSTGRES_DB=health_db

# ═══════════════════════════════════════════════════════════════════════════
# Bộ nhớ hội thoại & RAG
# ═══════════════════════════════════════════════════════════════════════════
# Một "turn" là một dòng trong chat_messages (gồm cả tool call/result),
# không phải một cặp user/assistant. Để quá thấp thì một câu hỏi nhiều tool
# ăn hết cửa sổ khiến bot mất mạch hội thoại.
MAX_HISTORY_TURNS=24
SUMMARY_MIN_NEW_TURNS=12
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.6

# D1 development observability. Both conditions are required; traces remain
# disabled by default and can never run when APP_ENVIRONMENT=production.
APP_ENVIRONMENT=production
# Firebase ID tokens are RS256 and are verified against this audience/issuer.
FIREBASE_PROJECT_ID=healthcare-191d8
# HS256 is accepted only in development/test harnesses, never production.
JWT_SECRET=replace-with-at-least-32-random-bytes-for-local-tests
# Public trace is always available. Debug execution telemetry is server-gated:
# development allows it, staging also requires a developer/admin principal,
# and production never streams it.
CHAT_TRACE_MODE=public
# Chặn câu ngoài phạm vi trước memory/RAG/LLM. Dùng off chỉ để rollback vận hành.
CHAT_SCOPE_GUARD_MODE=strict
# Encoder semantic nhỏ chạy local và chỉ nhận fragment hiện tại. Model được tải
# lười ở request đầu tiên; để trống sẽ dùng rule + JSON judge như cơ chế dự phòng.
SCOPE_ROUTER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Để trống cho SentenceTransformer tự chọn CPU/GPU.
SCOPE_ROUTER_DEVICE=
SCOPE_ROUTER_TIMEOUT_SECONDS=2.5
# Chờ tải encoder trước khi nhận traffic để request đầu không rơi về AMBIGUOUS.
SCOPE_ROUTER_WARMUP_TIMEOUT_SECONDS=45
# Đây là ngưỡng vận hành ban đầu, phải hiệu chỉnh lại bằng holdout tiếng Việt.
SCOPE_ROUTER_LOW_CONFIDENCE=0.55
SCOPE_ROUTER_HIGH_CONFIDENCE=0.85
SCOPE_ROUTER_TEMPERATURE=0.06
# Cosine similarity tối thiểu để semantic confidence được tính đủ hệ số 1.0.
SCOPE_ROUTER_FULL_CONFIDENCE_SIMILARITY=0.50
# Chỉ case uncertainty hoặc rule/classifier bất đồng mới gọi JSON scope judge.
# Judge không có tool/RAG/history và không được quyền trả lời người dùng.
SCOPE_CLASSIFIER_MODEL=chr/charm/qwen3.8-flash
SCOPE_CLASSIFIER_TIMEOUT_SECONDS=2.5
SCOPE_CLASSIFIER_CONFIDENCE=0.85
DEVELOPMENT_CONTEXT_TRACE=false

# D3.0 deterministic context planner. "shadow" records a structural preview
# only; it never changes prompts, tools, RAG, model selection, or responses.
# "enforced" is deliberately unsupported until a later development phase.
CONTEXT_PLANNER_MODE=off
# Plan V2 uses an isolated revision store until SQL enforcement gates pass.
PLAN_TOOL_MODE=shadow
# Optional privacy-redacted JSONL path for genuine natural shadow turns.
# Leave empty until collection is explicitly authorized for the environment.
CONTEXT_PLANNER_NATURAL_COLLECTION_PATH=

# ═══════════════════════════════════════════════════════════════════════════
# Dịch vụ ngoài
# ═══════════════════════════════════════════════════════════════════════════
WGER_BASE_URL=https://wger.de/api/v2

# Cloudflare Tunnel (tuỳ chọn — để expose ra internet)
CLOUDFLARE_TUNNEL_TOKEN=
